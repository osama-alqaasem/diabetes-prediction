# app.py
import streamlit as st
import numpy as np
import joblib
import pandas as pd

st.set_page_config(page_title="Diabetes Predictor", layout="centered")

st.title("نظام اختبار تنبؤ مرض السكري")
st.write("أدخل القيم التالية عشان النظام يقدّر إذا في احتمال لمرض السكري أم لا.")

# --- حمل الموديل و scaler و feature order ---
@st.cache_resource
def load_artifacts():
    model = joblib.load("diabetes_model.joblib")
    scaler = joblib.load("scaler.joblib")
    feature_order = joblib.load("feature_order.joblib")
    return model, scaler, feature_order

model, scaler, feature_order = load_artifacts()

# --- واجهة المستخدم: حقول الإدخال حسب مجموعة بيانات Pima ---
st.subheader("البيانات الشخصية / القياسات")
cols = st.columns(2)

# افتراضياً نعرض نفس ميزات مجموعة Pima: 
# ['Pregnancies','Glucose','BloodPressure','SkinThickness','Insulin','BMI','DiabetesPedigreeFunction','Age']
# نستخدم نفس الأسماء عشان الترتيب صحيح
inputs = {}
with cols[0]:
    inputs['Pregnancies'] = st.number_input("عدد حالات الحمل (Pregnancies)", min_value=0, max_value=20, value=1, step=1)
    inputs['Glucose'] = st.number_input("تركيز الجلوكوز (Glucose)", min_value=0, max_value=300, value=120)
    inputs['BloodPressure'] = st.number_input("ضغط الدم (BloodPressure)", min_value=0, max_value=200, value=70)
    inputs['SkinThickness'] = st.number_input("سمك الجلد (SkinThickness)", min_value=0, max_value=100, value=20)

with cols[1]:
    inputs['Insulin'] = st.number_input("مستوى الإنسولين (Insulin)", min_value=0, max_value=1000, value=79)
    inputs['BMI'] = st.number_input("مؤشر كتلة الجسم (BMI)", min_value=0.0, max_value=100.0, value=25.0, format="%.1f")
    inputs['DiabetesPedigreeFunction'] = st.number_input("عامل سلالة السكري (DiabetesPedigreeFunction)", min_value=0.0, max_value=5.0, value=0.5, format="%.3f")
    inputs['Age'] = st.number_input("العمر (Age)", min_value=0, max_value=120, value=33, step=1)

# --- ترتيب المدخلات بحسب feature_order المحفوظ ---
# بعض قواعد السلامة لو الـ feature_order اختلاف:
feat_order = feature_order  # قائمة أسماء الأعمدة المحفوظة
x_input = [inputs.get(f, 0) for f in feat_order]  # حافظ الترتيب، حط 0 لو مفقودة

# زر التنبؤ
if st.button("تنبؤ"):
    # تحويل وصياغة النتيجة
    x_array = np.array(x_input).reshape(1, -1)
    x_scaled = scaler.transform(x_array)
    pred = model.predict(x_scaled)[0]
    
    # إن الموديل يعطي احتمالات:
    if hasattr(model, "predict_proba"):
        prob = model.predict_proba(x_scaled)[0][1]  # احتمال الفئة 1 (سكري)
    else:
        prob = None

    # عرض النتيجة مع رسالة واضحة
    if pred == 1:
        st.error(f"التنبؤ: محتمل وجود مرض السكري ✅  — احتمال: {prob:.2%}" if prob is not None else "التنبؤ: احتمال مرض السكري (فئة 1)")
    else:
        st.success(f"التنبؤ: غير مصاب بمرض السكري ❌ — احتمال (مرض): {prob:.2%}" if prob is not None else "التنبؤ: فئة 0 (غير مصاب)")

    # عرض التفاصيل
    st.write("**تفاصيل الإدخال (مرتبة):**")
    df_show = pd.DataFrame([x_input], columns=feat_order)
    st.dataframe(df_show.T.rename(columns={0:"Value"}))

    if prob is not None:
        st.write("---")
        st.write("تفسير سريع:")
        if prob >= 0.75:
            st.warning("الاحتمال كبير — يُنصح بزيارة الطبيب وإجراء فحوصات رسمية.")
        elif prob >= 0.4:
            st.info("يوجد احتمال متوسط — راجع التاريخ الطبي واعتبارات نمط الحياة، وفكر بإجراء فحص إضافي.")
        else:
            st.success("احتمال منخفض — مع ذلك، لو ظهرت أعراض فاستشر الطبيب.")
